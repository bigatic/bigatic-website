<style>
  .field-sketch {
    position: relative;
    height: 5.25rem;
    margin: 0.85rem 0 0;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    color: var(--primary);
  }

  .field-sketch::before,
  .field-sketch::after {
    position: absolute;
    z-index: 1;
    width: 0.55rem;
    height: 0.55rem;
    border-color: var(--rule-strong);
    border-style: solid;
    content: '';
    pointer-events: none;
  }

  .field-sketch::before {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .field-sketch::after {
    right: 0;
    bottom: 0.35rem;
    border-width: 0 1px 1px 0;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .construction,
  .drawing,
  .drawing g,
  .caption-line {
    fill: none;
    stroke: currentcolor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .construction {
    opacity: 0.08;
    stroke-width: 0.7;
  }

  .drawing,
  .drawing g {
    stroke-width: 1.35;
  }

  .drawing .accent {
    color: var(--accent);
    stroke-width: 1.65;
  }

  .drawing .signal-fill {
    fill: currentcolor;
  }

  .caption-line {
    opacity: 0.36;
    stroke-dasharray: 2 3;
    stroke-width: 0.85;
  }
</style>
