---
import { ArrowUpRight, Building, Globe, MapPin } from '@lucide/astro';
import GithubIcon from '../icons/GithubIcon.astro';
import TransmissionConsole from '../TransmissionConsole.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import type { Locale } from '../../data/site';
import { contactPageCopy } from '../../data/pages';
import { siteConfig, siteLocation } from '../../data/site';
import { route } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const c = contactPageCopy[locale];
---

<ContentLayout
  title={c.title}
  description={c.description}
  locale={locale}
  alternatePath={route('contact', isEs ? 'en' : 'es')}
  canonicalPath={route('contact', locale)}
>
  <TransmissionConsole slot="hero-aside" loading="eager" />
  <section class="contact-section section-space">
    <div class="container-shell contact-grid">
      <div class="intro">
        <div class="module-bar" aria-hidden="true">
          <span class="bar-mark"></span>
          <span class="scale"></span>
        </div>
        <h2 class="section-title">{c.introTitle}</h2>
        <p>{c.introBody}</p>
      </div>

      <address class="identity-card chassis">
        <div class="identity-head">
          <Building size={20} stroke-width={1.5} aria-hidden="true" />
          <span>{c.group}</span>
        </div>
        <p><strong>{c.university}</strong><br />{c.program}</p>
        <p class="location">
          <MapPin size={16} aria-hidden="true" />
          <span>
            <small class="mono-label">{c.location}</small>
            {siteLocation}
          </span>
        </p>
      </address>

      <div class="channels">
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">
          <GithubIcon size={20} />
          <span><small class="mono-label">{c.github}</small>github.com/bigatic</span>
          <ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href={siteConfig.institutionalPage} target="_blank" rel="noopener noreferrer">
          <Building size={20} aria-hidden="true" />
          <span><small class="mono-label">{c.profile}</small>udes.edu.co</span>
          <ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href={siteConfig.domain}>
          <Globe size={20} aria-hidden="true" />
          <span><small class="mono-label">{c.website}</small>bigatic.org</span>
          <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</ContentLayout>

<style>
  .contact-section {
    background: var(--surface);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(19rem, 0.75fr) minmax(20rem, 0.9fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .bar-mark {
    width: 0.85rem;
    height: 0.85rem;
    flex: none;
    border-top: 2px solid var(--primary);
    border-left: 2px solid var(--primary);
  }

  .intro .module-bar {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .intro p {
    max-width: 52ch;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
  }

  .identity-card {
    border: 1px solid var(--border);
    border-top: 2px solid var(--primary);
    font-style: normal;
    padding: 1.35rem 1.4rem 1.5rem;
  }

  .identity-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-bottom: 1px solid var(--border);
    color: var(--primary);
    padding-bottom: 1rem;
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .identity-head > :global(svg) {
    flex: none;
    color: var(--primary-hover);
  }

  .identity-card > p {
    margin: 1.1rem 0 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .identity-card strong {
    color: var(--text);
    font-weight: 650;
  }

  .identity-card .location {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    border-top: 1px dotted var(--rule-strong);
    color: var(--primary);
    padding-top: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .identity-card .location > :global(svg) {
    margin-top: 0.55rem;
    color: var(--primary-hover);
  }

  .identity-card .location small {
    display: block;
    margin-bottom: 0.2rem;
  }

  .channels {
    display: grid;
    border-top: 2px solid var(--primary);
  }

  .channels a {
    display: grid;
    min-height: 4.75rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--primary);
    padding-inline: 0.15rem;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease,
      padding-inline var(--motion-fast) ease;
  }

  .channels span {
    font-size: 0.94rem;
    font-weight: 620;
  }

  .channels small {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.62rem;
  }

  .channels :global(svg) {
    flex: none;
    color: var(--primary-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    /* El renglon se desplaza dentro de su propia caja: no mueve el layout. */
    .channels a:hover {
      background: var(--surface-muted);
      padding-inline: 0.6rem 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channels a:hover {
      padding-inline: 0.15rem;
    }
  }

  @media (max-width: 60rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }

    .intro {
      grid-column: 1/-1;
    }
  }

  @media (max-width: 42rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
