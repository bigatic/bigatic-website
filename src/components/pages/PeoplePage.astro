---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import CatalogEmptyState from '../CatalogEmptyState.astro';
import PeopleGrid from '../PeopleGrid.astro';
import type { Locale } from '../../data/site';
import { peoplePageCopy, peopleRoleLabels, peopleRoles } from '../../data/pages';
import { route } from '../../i18n/routes';
import { Trophy } from '@lucide/astro';
import { inLocale, isPublished } from '../../utils/content';
import RankLadder from '../RankLadder.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const nameCollator = new Intl.Collator(locale, { sensitivity: 'base' });
const people = (await getCollection('people'))
  .filter(inLocale(locale))
  .filter(isPublished)
  .sort((a, b) => nameCollator.compare(a.data.name, b.data.name));
const roles = peopleRoles;
const labels = peopleRoleLabels[locale];
const c = peoplePageCopy[locale];
---

<ContentLayout
  title={c.title}
  description={c.description}
  locale={locale}
  alternatePath={route('people', isEs ? 'en' : 'es')}
  canonicalPath={route('people', locale)}
>
  <aside slot="hero-aside" class="directory-summary">
    <div>
      <strong data-count={people.length}>{String(people.length).padStart(2, '0')}</strong>
      <span>{people.length === 1 ? c.publishedProfile : c.publishedProfiles}</span>
    </div>
    <h2>{c.modelTitle}</h2>
    <p>{c.modelBody}</p>
  </aside>
  <section class="directory section-space surface-grid" aria-labelledby="directory-list-title">
    <div class="container-shell">
      <h2 class="sr-only" id="directory-list-title">{c.title}</h2>
      {
        people.length === 0 ? (
          <CatalogEmptyState
            title={c.emptyTitle}
            description={c.emptyBody}
            href={route('contact', locale)}
            linkLabel={c.contact}
          />
        ) : (
          <>
            <section class="rank-legend" aria-labelledby="rank-legend-title">
              <div class="rank-legend-head">
                <Trophy size={17} stroke-width={1.8} aria-hidden="true" />
                <h2 id="rank-legend-title">{c.rankLegendTitle}</h2>
              </div>
              <RankLadder locale={locale} />
              <p>
                <span>{c.rankLegendBody}</span>
              </p>
            </section>
            <div class="role-groups">
              <div
                class="directory-order"
                aria-label={`${c.alphabeticalOrder}. ${c.alphabeticalDetail}`}
              >
                <span aria-hidden="true">A-Z</span>
                <p>
                  <strong>{c.alphabeticalOrder}</strong>
                  {c.alphabeticalDetail}
                </p>
              </div>
              {roles.map((role) => {
                const members = people.filter((person) => person.data.role === role);
                if (members.length === 0) return null;
                return (
                  <section>
                    <header>
                      <h2>{labels[role]}</h2>
                      <span>{String(members.length).padStart(2, '0')}</span>
                    </header>
                    <PeopleGrid people={members} locale={locale} />
                  </section>
                );
              })}
            </div>
          </>
        )
      }
    </div>
  </section>
</ContentLayout>

<style>
  .directory-summary {
    border-top: 3px solid var(--primary);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 1.5rem;
  }
  .directory-summary > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .directory-summary strong {
    color: var(--primary);
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .directory-summary span {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .directory-summary h2 {
    margin: 1.35rem 0 0;
    color: var(--primary);
    font-size: 1.25rem;
  }
  .directory-summary p {
    max-width: 52ch;
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .directory {
    border-block: 1px solid var(--border);
  }
  .role-groups {
    display: grid;
    gap: 0;
  }
  .role-groups > section + section {
    margin-top: 4rem;
  }
  .directory-order {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 2.5rem auto;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    box-shadow: 0 0.8rem 2rem rgba(8, 45, 87, 0.06);
    padding: 0.55rem 0.8rem 0.55rem 0.55rem;
  }
  .directory-order > span {
    display: grid;
    min-width: 3.35rem;
    min-height: 2.35rem;
    place-items: center;
    border-radius: 0;
    background: var(--primary);
    color: white;
    font-size: 0.72rem;
    font-weight: 780;
    letter-spacing: 0.1em;
  }
  .directory-order p {
    display: grid;
    gap: 0.12rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.65rem;
    line-height: 1.3;
  }
  .directory-order strong {
    color: var(--primary);
    font-size: 0.7rem;
  }
  .rank-legend {
    margin: 0 0 2.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-top: 3px solid var(--primary);
    border-radius: 0;
    background:
      radial-gradient(circle at 88% 0%, rgba(16, 41, 61, 0.06), transparent 60%),
      linear-gradient(180deg, var(--surface), var(--surface-muted));
    box-shadow: 0 0.9rem 2.4rem rgba(8, 45, 87, 0.07);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .rank-legend-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
    color: var(--primary);
  }
  .rank-legend h2 {
    margin: 0;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Divider spans the panel; the text stays at a readable measure. */
  .rank-legend > p {
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .rank-legend > p span {
    display: block;
    max-width: 74ch;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }
  .role-groups section > header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid var(--primary);
    padding-bottom: 1rem;
  }
  .role-groups h2 {
    margin: 0;
    color: var(--primary);
    font-size: 1.5rem;
  }
  .role-groups header span {
    color: #526b82;
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>
