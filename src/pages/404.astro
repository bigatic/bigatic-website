---
import { ArrowLeft, SearchX } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada - Page not found | BIGATIC"
  description="La página solicitada no existe. The requested page does not exist."
  locale="es"
  alternatePath={null}
  canonicalPath="/404/"
  robots="noindex, follow"
>
  <section class="not-found">
    <div class="container-shell content">
      <div class="code" aria-hidden="true">404</div>
      <SearchX size={44} stroke-width={1.3} aria-hidden="true" />
      <h1>Página no encontrada.</h1>
      <p>
        La dirección puede haber cambiado o no existir. <span lang="en"
          >The address may have changed or may not exist.</span
        >
      </p>
      <div class="actions">
        <a class="button-primary" href="/"
          ><ArrowLeft size={17} aria-hidden="true" />Volver al inicio</a
        ><a class="button-secondary" href="/en/"><span lang="en">Back to home</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    display: grid;
    min-height: 70svh;
    place-items: center;
    background: linear-gradient(135deg, #f8fcff, #eef6fb);
  }
  .content {
    padding-block: 5rem;
    text-align: center;
  }
  .content > :global(svg) {
    margin-inline: auto;
    color: var(--primary-hover);
  }
  .code {
    color: #d8e5f0;
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.09em;
    line-height: 0.8;
  }
  h1 {
    margin: 2rem 0 0.8rem;
    color: var(--primary);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.04em;
  }
  p {
    max-width: 52ch;
    margin: 0 auto;
    color: var(--text-muted);
  }
  p span {
    display: block;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2rem;
  }
</style>
