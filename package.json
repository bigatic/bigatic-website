{
  "name": "bigatic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual institutional website for the BIGATIC Research Group at Universidad de Santander.",
  "homepage": "https://bigatic.org",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-built-links.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-built-links.mjs",
    "check:content": "node scripts/check-content-integrity.mjs",
    "verify": "npm run check && npm run test && npm run check:content && npm run lint && npm run format:check && npm run build",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lucide/astro": "1.31.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "1.5.0",
    "js-yaml": "4.3.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
